#!/usr/bin/env python3
# cc-tail [log] [n]: compact view of a cc-run stream-json log (last n events)
import json,sys,os
log=sys.argv[1] if len(sys.argv)>1 else os.path.expanduser('.cc/latest.jsonl'); n=int(sys.argv[2]) if len(sys.argv)>2 else 25
out=[]
for line in open(log,errors='replace'):
    try: e=json.loads(line)
    except Exception: out.append('RAW '+line.strip()[:200]); continue
    t=e.get('type')
    if t=='assistant':
        for c in e['message'].get('content',[]):
            if c.get('type')=='text': out.append('SAY '+c['text'].strip()[:600])
            elif c.get('type')=='tool_use':
                i=c.get('input',{}); a=i.get('command') or i.get('file_path') or i.get('pattern') or json.dumps(i)[:120]
                out.append(f"USE {c['name']}: {str(a)[:160]}")
    elif t=='user':
        for c in e['message'].get('content',[]) if isinstance(e['message'].get('content'),list) else []:
            if c.get('type')=='tool_result' and c.get('is_error'):
                cc=c.get('content'); out.append('ERR '+(cc if isinstance(cc,str) else json.dumps(cc))[:200])
    elif t=='result':
        out.append(f"END {e.get('subtype')} turns={e.get('num_turns')} cost=${e.get('total_cost_usd',0):.2f}\n"+str(e.get('result',''))[:3000])
print('\n'.join(out[-n:]))
